# --- core ------------------------------------------------------------------
ENV=dev
DEBUG=false

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/codescout
REDIS_URL=redis://localhost:6379/0

# --- secrets ---------------------------------------------------------------
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# GitHub OAuth app: https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FRONTEND_ORIGIN=http://localhost:3000

# --- providers -------------------------------------------------------------
# Set both to "fake" to run the whole stack offline with no API keys.
LLM_PROVIDER=anthropic
EMBEDDING_PROVIDER=voyage

ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

ANSWER_MODEL=claude-sonnet-4-5
OVERVIEW_MODEL=claude-haiku-4-5
EMBEDDING_MODEL=voyage-code-3

# --- agent -----------------------------------------------------------------
TOOL_BUDGET=12
PROMPT_VERSION=answer_v1

# --- ingestion limits ------------------------------------------------------
MAX_REPO_FILES=50000
MAX_FILE_BYTES=1000000
MAX_CHUNK_TOKENS=700
